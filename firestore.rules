rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /sample_events/{eventId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['id', 'sampleId', 'type', 'createdAt'])
        && request.resource.data.keys().hasAll(['id', 'sampleId', 'type', 'createdAt'])
        && request.resource.data.id == eventId
        && request.resource.data.sampleId is string
        && request.resource.data.sampleId.size() > 0
        && request.resource.data.type in ['RECEIVED', 'PREPARED', 'IN_ANALYSIS', 'VALIDATED', 'ARCHIVED']
        && request.resource.data.createdAt is timestamp;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
